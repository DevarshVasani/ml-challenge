{
  "adapter_type": "mdeberta",
  "checkpoint": "microsoft/mdeberta-v3-base",
  "max_length": 256,
  "training": {
    "adapter_type": "mdeberta",
    "microbatch": 8,
    "gradient_accumulation": 8,
    "learning_rate": 2e-05,
    "epochs": 1,
    "warmup_fraction": 0.05,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "precision": "fp16",
    "device": "cuda",
    "run_dir": "artifacts/neural-mdeberta",
    "num_workers": 0,
    "log_every": 25,
    "checkpoint_every": 250
  },
  "pair_manifest": "artifacts/neural-data/train_pairs_manifest.json",
  "pair_subdir": "train_pairs",
  "query_manifest": "artifacts/neural-data/query_manifest.json"
}
