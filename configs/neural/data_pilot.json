{
  "seed": 42,
  "data": {
    "s1": "student_resource/dataset/train/train_source1.tsv",
    "s2": "student_resource/dataset/train/train_source2.tsv",
    "s3": "student_resource/dataset/train/train_source3.tsv",
    "ground_truth": "student_resource/dataset/train/train_ground_truth.tsv",
    "folds": "artifacts/folds.tsv"
  },
  "queries": {"train": 50000, "train_folds": [1, 2], "heldout": 5000, "heldout_fold": 0, "threshold": 2500},
  "source_pool_policy": "full verified retrieval background; labels only select training pairs",
  "source_store": "artifacts/source-store.sqlite",
  "candidate_dir": "artifacts/neural-candidates",
  "index_workers": 1,
  "sparse_threads": 2,
  "memory_limit_mb": 4096,
  "disk_limit_gb": 200,
  "query_batch_size": 128,
  "source_read_chunk_rows": 25000,
  "pair_join_target_rows": 25000,
  "bootstrap_train_queries": 1000,
  "resume": true,
  "strict_country": false,
  "shard_target_rows": 75000,
  "output_dir": "artifacts/neural-data"
}
